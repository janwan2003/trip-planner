# Vite fingerprints every file in /assets with a content hash, so a given URL can never
# change what it returns. The default `max-age=14400, must-revalidate` made a repeat
# visitor revalidate the whole bundle every four hours for nothing.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTTP already 301s to HTTPS; this removes the round trip that the redirect costs.
# Without `includeSubDomains` on purpose - no subdomain of wegowhen.com is served here,
# and committing every future one to HTTPS is not this file's decision to make.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
