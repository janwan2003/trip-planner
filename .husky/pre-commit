# Gates run before the push, not after: a failure here is cheaper than a red CI.
# pnpm 11 needs Node >= 22.13, and the system Node may be older, so prefer nvm's.
if [ -x "$HOME/.nvm/versions/node/v22.23.1/bin/node" ]; then
  PATH="$HOME/.nvm/versions/node/v22.23.1/bin:$PATH"
  export PATH
fi

pnpm exec lint-staged
pnpm run typecheck
pnpm run test
